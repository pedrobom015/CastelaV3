server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # Libera só essas:
    location /api/validar-licenca/ {
        proxy_pass http://presserv-backend:3000/api/validar-licenca/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        allow all;
    }

    location /api/keepalive/ {
        proxy_pass http://presserv-backend:3000/api/keepalive/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        allow all;
    }

    # Para o restante do /api, libera para uso interno:
    location /api/ {
        proxy_pass http://presserv-backend:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;

        # Permite localhost
        allow 127.0.0.1;
        allow ::1;

        # Permite toda a VPC da AWS (172.31.0.0/16)
        allow 172.31.0.0/16;

        # (Opcional) Permitir seu IP de casa/escritório
        # allow 66.131.127.113;

        deny all;
    }
}
